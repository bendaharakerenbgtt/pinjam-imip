        <!-- Status Dikonfirmasi -> Hadir Hari-H -->
        <mxCell id="edge11" edge="1" source="node_status_dikonfirmasi" target="node_hadir" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FF7300;strokeWidth=2;">
