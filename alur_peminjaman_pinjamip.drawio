  <diagram id="AlurPeminjamanPinjamip" name="Alur Peminjaman Inventaris LDK IMIP">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size:20px; color:#0F172A;&quot;&gt;ALUR LENGKAP SISTEM PEMINJAMAN INVENTARIS (PINJAMIP)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#64748B;&quot;&gt;UKM Lembaga Dakwah Kampus Ikatan Mahasiswa Islam Politeknik (LDK IMIP)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FF7300;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- SWIMLANES -->
        <mxCell id="lane_peminjam" value="&lt;b style=&quot;font-size:14px; color:#EA580C;&quot;&gt;1. PEMINJAM (USER / ORMAWA)&lt;/b&gt;" style="swimlane;startSize=35;fillColor=#FFFBF7;strokeColor=#FF7300;strokeWidth=2;html=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="95" width="320" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="lane_sistem" value="&lt;b style=&quot;font-size:14px; color:#2563EB;&quot;&gt;2. SISTEM WEB PINJAMIP&lt;/b&gt;" style="swimlane;startSize=35;fillColor=#F8FAFC;strokeColor=#3B82F6;strokeWidth=2;html=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="390" y="95" width="320" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="lane_admin" value="&lt;b style=&quot;font-size:14px; color:#059669;&quot;&gt;3. PENGURUS INVENTARIS (ADMIN)&lt;/b&gt;" style="swimlane;startSize=35;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=2;html=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="730" y="95" width="320" height="1060" as="geometry" />
        </mxCell>

        <!-- ================= PEMINJAM COLUMN ================= -->
        <mxCell id="node_start" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;MULAI&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF7300;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="lane_peminjam">
          <mxGeometry x="110" y="50" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="node_pilih" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;1. Pilih Perlengkapan di Katalog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Cek stok &amp; masukkan barang ke keranjang&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF7300;strokeWidth=1.5;" vertex="1" parent="lane_peminjam">
          <mxGeometry x="40" y="115" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_form" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;2. Isi Formulir Pengajuan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Nama, No WA aktif, Tanggal &amp; Keperluan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF7300;strokeWidth=1.5;" vertex="1" parent="lane_peminjam">
          <mxGeometry x="40" y="195" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_balas_wa" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;4. Terima &amp; Balas Chat WA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Peminjam konfirmasi balasan persetujuan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF7300;strokeWidth=1.5;" vertex="1" parent="lane_peminjam">
          <mxGeometry x="40" y="475" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_hadir" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;5. Datang ke Sekre pada Hari-H&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Hadir sesuai tanggal pengambilan disepakati&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF7300;strokeWidth=1.5;" vertex="1" parent="lane_peminjam">
          <mxGeometry x="40" y="660" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_kembalikan" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;6. Kembalikan Barang ke Sekre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Tepat waktu, kondisi bersih &amp; lengkap&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF7300;strokeWidth=1.5;" vertex="1" parent="lane_peminjam">
          <mxGeometry x="40" y="850" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_selesai_peminjam" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;SELESAI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#D1FAE5;&quot;&gt;Tuntas &amp; Berkah&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;strokeWidth=2;" vertex="1" parent="lane_peminjam">
          <mxGeometry x="105" y="945" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- ================= SISTEM PINJAMIP COLUMN ================= -->
        <mxCell id="node_validasi" value="&lt;b style=&quot;color:#1E3A8A;&quot;&gt;Cek Aturan H-3&lt;br&gt;&amp; Bentrok Jadwal?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;" vertex="1" parent="lane_sistem">
          <mxGeometry x="65" y="185" width="190" height="75" as="geometry" />
        </mxCell>

        <mxCell id="node_terbit_kode" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Kode Pinjam Terbit (PJM-xxxx)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#D97706; font-weight:bold;&quot;&gt;Status: MENUNGGU VERIFIKASI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;" vertex="1" parent="lane_sistem">
          <mxGeometry x="40" y="295" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_status_dikonfirmasi" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Stok Terkunci 100% Aman&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#059669; font-weight:bold;&quot;&gt;Status: DIKONFIRMASI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;" vertex="1" parent="lane_sistem">
          <mxGeometry x="40" y="565" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_status_dipinjam" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Tercatat Jam Serah Terima&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#2563EB; font-weight:bold;&quot;&gt;Status: SEDANG DIPINJAM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;" vertex="1" parent="lane_sistem">
          <mxGeometry x="40" y="755" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_status_selesai" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Stok Otomatis Kembali Aktif&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#059669; font-weight:bold;&quot;&gt;Status: SELESAI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="lane_sistem">
          <mxGeometry x="40" y="940" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ================= PENGURUS ADMIN COLUMN ================= -->
        <mxCell id="node_review" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;3. Review Pengajuan Masuk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Cek identitas &amp; ketersediaan fisik barang&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="40" y="295" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_decide_admin" value="&lt;b style=&quot;color:#064E3B;&quot;&gt;Disetujui?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="90" y="380" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_tolak" value="&lt;b style=&quot;color:#991B1B;&quot;&gt;Tolak / Batalkan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#EF4444;&quot;&gt;Status: DITOLAK&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="195" y="475" width="115" height="45" as="geometry" />
        </mxCell>

        <mxCell id="node_approve" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Approve &amp; Kirim Chat WA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#059669;&quot;&gt;No. Dokumen Surat Resmi Terbit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="15" y="475" width="165" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_serah_terima" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Serah Terima &amp; Cek Fisik&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Tanda tangan Surat &amp; Admin serahkan barang&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="40" y="660" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="node_terima_kembali" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Verifikasi Pengembalian&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Admin cek kelengkapan fisik &amp; klik selesai&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;" vertex="1" parent="lane_admin">
          <mxGeometry x="40" y="850" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- ================= CONNECTORS / PANAH ALUR ================= -->
        <!-- Peminjam: Start -> Pilih -> Form -->
        <mxCell id="edge1" edge="1" source="node_start" target="node_pilih" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FF7300;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge2" edge="1" source="node_pilih" target="node_form" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FF7300;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Form -> Validasi Sistem -->
        <mxCell id="edge3" edge="1" source="node_form" target="node_validasi" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Validasi Gagal (Loop kembali ke Form) -->
        <mxCell id="edge4_gagal" edge="1" source="node_validasi" target="node_form" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="260" />
              <mxPoint x="210" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_gagal" value="Kurang H-3 / Bentrok (Revisi Tgl)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#EF4444;fontStyle=1;fontSize=10;" vertex="1" connectable="0" parent="edge4_gagal">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Validasi Sukses -> Terbit Kode Pinjam -->
        <mxCell id="edge5_ok" edge="1" source="node_validasi" target="node_terbit_kode" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_ok" value="Valid (Lolos)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#2563EB;fontStyle=1;fontSize=10;" vertex="1" connectable="0" parent="edge5_ok">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="1" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Terbit Kode -> Review Admin -->
        <mxCell id="edge6" edge="1" source="node_terbit_kode" target="node_review" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Review -> Decide -->
        <mxCell id="edge7" edge="1" source="node_review" target="node_decide_admin" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decide -> Tolak -->
        <mxCell id="edge8_tolak" edge="1" source="node_decide_admin" target="node_tolak" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_tolak" value="Tidak" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#EF4444;fontStyle=1;fontSize=10;" vertex="1" connectable="0" parent="edge8_tolak">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Decide -> Approve -->
        <mxCell id="edge8_approve" edge="1" source="node_decide_admin" target="node_approve" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_setuju" value="Ya (Setuju)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#059669;fontStyle=1;fontSize=10;" vertex="1" connectable="0" parent="edge8_approve">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Approve -> Chat WA Peminjam -->
        <mxCell id="edge9" edge="1" source="node_approve" target="node_balas_wa" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_chat_wa" value="Kirim Notifikasi WA" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#059669;fontStyle=1;fontSize=10;" vertex="1" connectable="0" parent="edge9">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Balas WA -> Status Dikonfirmasi -->
        <mxCell id="edge10" edge="1" source="node_balas_wa" target="node_status_dikonfirmasi" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="690" />
              <mxPoint x="550" y="690" />
            </Array>
