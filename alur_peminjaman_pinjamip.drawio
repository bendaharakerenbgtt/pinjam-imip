          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Serah Terima Admin -> Status Sedang Dipinjam -->
        <mxCell id="edge13" edge="1" source="node_serah_terima" target="node_status_dipinjam" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="830" />
              <mxPoint x="550" y="830" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Status Dipinjam -> Kembalikan Barang -->
        <mxCell id="edge14" edge="1" source="node_status_dipinjam" target="node_kembalikan" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FF7300;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="925" />
              <mxPoint x="210" y="925" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Kembalikan Barang -> Terima Kembali Admin -->
        <mxCell id="edge15" edge="1" source="node_kembalikan" target="node_terima_kembali" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Terima Kembali -> Status Selesai Sistem -->
        <mxCell id="edge16" edge="1" source="node_terima_kembali" target="node_status_selesai" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
